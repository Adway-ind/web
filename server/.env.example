# Database (required for API routes that read or write site data)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adway

# Local server settings
PORT=5000
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=

# Authentication (set secure values before deployment)
ADMIN_EMAIL=admin@adway.com
ADMIN_PASS=change-me
JWT_SECRET=replace-with-a-long-random-secret

# Optional integrations. The server starts without these in local development.
RESEND_API_KEY=
EMAIL_USER=
EMAIL_PASS=
