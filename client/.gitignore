# ==========================================
# Dependencies
# ==========================================
node_modules/
**/node_modules/

# ==========================================
# Environment variables / secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Build output
# ==========================================
dist/
**/dist/
build/
**/build/

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Vite
# ==========================================
.vite/

# ==========================================
# Editor
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# OS
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Temporary files
# ==========================================
tmp/
temp/
*.tmp

# ==========================================
# Server uploads
# ==========================================
server/uploads/*

# Keep upload folders in Git
!server/uploads/
!server/uploads/logos/
!server/uploads/resumes/

# Don't upload actual user files
server/uploads/logos/*
server/uploads/resumes/*

# Keep folders with .gitkeep
!server/uploads/logos/.gitkeep
!server/uploads/resumes/.gitkeep